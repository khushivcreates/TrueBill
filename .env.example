# Required by the Vercel serverless API. Keep the actual key out of Git.
GEMINI_API_KEY="your_gemini_api_key"

# Optional. The default supports bill images and PDFs with standard Gemini API keys.
GEMINI_MODEL="gemini-2.5-flash"

# Optional. Leave unset to use this project's /api/process endpoint.
# VITE_API_URL="https://your-api.example.com"

# Optional. Set to true only when you want the UI's built-in demo data.
# VITE_DEMO_MODE="true"
